{
  "terms": [
    {"term": "GC TE Policy", "term_zh": "Global China 差旅费用政策", "definition": "BCG Global China 办公室统一的 Travel & Expense 政策，适用于中国大陆、香港、台湾。", "category": "general", "related_chapters": ["ch01"]},
    {"term": "GFOS", "term_zh": "Global Finance & Operations Services", "definition": "BCG 全球财务运营服务团队，负责 T&E Audit、Policy 维护和 Compliance。", "category": "compliance", "related_chapters": ["ch11"]},
    {"term": "GFOC", "term_zh": "Global Finance Operations Centre", "definition": "GFOS 下属的运营中心，位于 New Delhi 等地，负责 Pre-payment Audit。", "category": "compliance", "related_chapters": ["ch11"]},
    {"term": "Amex GBT", "term_zh": "美国运通全球商务旅行", "definition": "BCG 指定的 TMC (Travel Management Company)，负责机票、酒店预订。", "category": "travel", "related_chapters": ["ch06"]},
    {"term": "TripSource", "term_zh": "在线预订工具", "definition": "BCG 的 OBT (Online Booking Tool)，中国区版本为 TripSource China。", "category": "travel", "related_chapters": ["ch06", "ch12"]},
    {"term": "Concur", "term_zh": "SAP Concur 费用管理系统", "definition": "BCG 使用的 Expense Management 系统，用于提交和审批费用报告。", "category": "submission", "related_chapters": ["ch10"]},
    {"term": "Pre-trip Approval", "term_zh": "出差预审批", "definition": "出差前必须获得的 Manager 批准，适用于国际出差和 Out-of-Policy 预订。", "category": "compliance", "related_chapters": ["ch06"]},
    {"term": "Out-of-Policy", "term_zh": "不合规", "definition": "不符合 GC TE Policy 规定的预订或费用，需额外审批。", "category": "compliance", "related_chapters": ["ch09", "ch11"]},
    {"term": "Nightly Cap", "term_zh": "住宿夜限额", "definition": "按城市等级设定的酒店每晚最高报销金额。", "category": "travel", "related_chapters": ["ch05"]},
    {"term": "Daily Allowance", "term_zh": "日津贴", "definition": "每日餐饮报销上限，Allowance 内无需收据。", "category": "expense", "related_chapters": ["ch07"]},
    {"term": "Preferred Vendor", "term_zh": "优选供应商", "definition": "BCG 有协议价的航司、酒店集团，应优先选择。", "category": "travel", "related_chapters": ["ch03", "ch05"]},
    {"term": "Cost Center", "term_zh": "成本中心", "definition": "员工所属部门的财务编码，Concur 报销必填项。", "category": "submission", "related_chapters": ["ch10"]},
